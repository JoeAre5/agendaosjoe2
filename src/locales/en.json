      "intro": "Summary of how attribution and referred production work.",
      "production": {
        "title": "What counts as referred production?",
        "body": "Completed payments from attributed clients on the referrer: services and products. Tips are excluded. Production is recorded at payment time, not at booking."
      },
      "notCounted": {
        "title": "What does not count?",
        "body": "Tips, refunds, cancelled appointments, unpaid appointments and payments before the attribution. Appointments booked by the referrer themselves also do not count."
      },
      "reset": {
        "title": "90-day reset",
        "body": "If the attributed client makes no payments for 90 consecutive days, the attribution becomes available for reset. Another referrer can capture it on the next paid booking."
      },
      "reallocation": {
        "title": "Reallocation",
        "body": "If a client books consecutively with another barber and completes 3 paid visits, the system reallocates the attribution to that barber."
      },
      "points": {
        "title": "Points",
        "body": "For every dollar paid by a referred client, the referrer earns points based on the configured ratio. Points can be redeemed for benefits."
      },
      "refunds": {
        "title": "Refunds and cancellations",
        "body": "Refunds create a negative production entry and reverse the corresponding points. Cancellations before payment do not affect production or points."
